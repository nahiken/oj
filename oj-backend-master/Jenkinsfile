pipeline {
    agent any

    // 使用Jenkins上的nodejs 18工具
    tools {
        maven 'maven 3.9.9'
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn clean compile -DskipTests -pl \'!code-sandbox-sdk-test\''
            }
        }

        stage('Package') {
            steps {
                sh 'mvn package -DskipTests -pl \'!code-sandbox-sdk-test\''
            }
        }

        stage('Deploy') {
            steps {
                sshPublisher(publishers: [
                    sshPublisherDesc(
                        configName: 'host-deploy',
                        transfers: [
                            sshTransfer(
                                sourceFiles: 'gateway/target/*.jar',
                                removePrefix: 'gateway/target',
                                remoteDirectory: './backend/oj-backend'
                            ),
                            sshTransfer(
                                sourceFiles: 'judge/target/*.jar',
                                removePrefix: 'judge/target',
                                remoteDirectory: './backend/oj-backend'
                            ),
                            sshTransfer(
                                sourceFiles: 'user/target/*.jar',
                                removePrefix: 'user/target',
                                remoteDirectory: './backend/oj-backend'
                            ),
                            sshTransfer(
                                sourceFiles: 'code-sandbox/target/*.jar',
                                removePrefix: 'code-sandbox/target',
                                remoteDirectory: './backend/oj-backend'
                            ),
                            sshTransfer(
                                execCommand: '''
                                    echo "✅ 文件上传完成，开始执行部署任务"
                                    cd /software/app/backend/oj-backend

                                    # 关闭旧进程并启动新进程
                                    for svc in gateway judge user code-sandbox; do
                                        JAR=$(ls ${svc}-*.jar 2>/dev/null | head -n 1)
                                        if [ -n "$JAR" ]; then
                                            PID=$(ps -ef | grep $JAR | grep -v grep | awk '{print $2}')
                                            if [ -n "$PID" ]; then
                                                kill -9 $PID
                                                echo "已杀死 $svc 旧进程: $PID"
                                            fi
                                            nohup /software/jdk-21.0.5/bin/java -jar $JAR --spring.config.location=/software/app/backend/config/$svc/application.yml > /software/app/backend/log/$svc.log 2>&1 &
                                            echo "$svc 已启动"
                                        else
                                            echo "$svc jar 未找到，跳过启动"
                                        fi
                                    done
                                    echo "✅ 所有服务已部署并尝试启动完毕"
                                '''
                            )
                        ],
                        usePromotionTimestamp: false,
                        verbose: true
                    )
                ])
            }
        }
    }

    post {
        success {
            echo '部署成功 ✅'
        }
        failure {
            echo '部署失败 ❌'
        }
    }
}